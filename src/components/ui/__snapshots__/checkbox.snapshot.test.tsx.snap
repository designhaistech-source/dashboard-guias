// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Checkbox (snapshots) > com className customizada 1`] = `
<button
  aria-checked="false"
  aria-label="Aceitar termos"
  class="grid place-content-center peer shrink-0 rounded-sm border border-primary shadow cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground h-5 w-5"
  data-state="unchecked"
  role="checkbox"
  type="button"
  value="on"
/>
`;

